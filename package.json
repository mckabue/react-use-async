{
  "name": "@mckabue/react-use-async",
  "version": "1.0.2",
  "description": "A lightweight React hook for managing async operations with loading states, error handling, and data merging.",
  "keywords": [
    "react",
    "hook",
    "async",
    "useAsync",
    "loading",
    "typescript",
    "react-hook"
  ],
  "author": "Kabui Charles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mckabue/react-use-async.git"
  },
  "bugs": {
    "url": "https://github.com/mckabue/react-use-async/issues"
  },
  "homepage": "https://github.com/mckabue/react-use-async#readme",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "!src/__tests__",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.esm.js",
        "require": "./dist/index.js"
      }
    },
    "files": [
      "dist",
      "README.md",
      "LICENSE"
    ]
  },
  "scripts": {
    "build": "vite build",
    "dev": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "terser": "^5.46.1",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^5.1.0"
  }
}
